# Cloudflare Pages headers. Replaces the Apache .htaccess this site used on its
# previous host. Cloudflare consumes this file as configuration, so it is not
# served publicly.
#
# HTTPS itself needs no config here: Pages issues and enforces TLS, so there is
# no redirect rule to maintain and no certificate to renew.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  # Safe to set unconditionally — Pages always serves this site over HTTPS.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Filenames here carry a content hash, so a new build emits new names.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate or visitors keep seeing the previous deploy.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
